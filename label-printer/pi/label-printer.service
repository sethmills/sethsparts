[Unit]
Description=Seth's Parts Zebra GK420T print-bridge
After=network.target

[Service]
Type=simple
User=seth
WorkingDirectory=/home/seth/label-printer
EnvironmentFile=/etc/label-printer/env
ExecStart=/usr/bin/python3 /home/seth/label-printer/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
