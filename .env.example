# Copy this to .env (gitignored, never committed) and fill in real values.
# Used by docker-compose.yml for the production container; for local dev,
# manage.py falls back to sensible defaults for everything except the pieces
# marked "required in production".

# --- Core Django (required in production) -----------------------------------
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated list of hostnames this instance serves, e.g.:
#   DJANGO_ALLOWED_HOSTS=sethsparts.com
DJANGO_ALLOWED_HOSTS=

# --- Cloudflare Tunnel (optional) --------------------------------------------
# Only needed if you want to reach the app from outside your network. Leave blank and
# `docker compose up -d` just runs the app on 127.0.0.1:3200 -- the tunnel is an opt-in
# profile (`docker compose --profile tunnel up -d`), so this is not required to start.
# From Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel) -> the
# connector token shown when you create/view it.
TUNNEL_TOKEN=

# --- Optional integrations ----------------------------------------------------
# Each of these is fully optional -- leave blank and the corresponding feature
# just reports "not configured" instead of erroring.

# Home Assistant Assist voice search (GET /api/locate/?q=...). Shared secret,
# not a session login, since HA calls this machine-to-machine.
VOICE_SEARCH_API_KEY=

# LED "find the part" indicator system -- a Raspberry Pi + Feather RP2040
# Scorpio running the firmware/bridge in led-controller/. URL is that Pi's
# print-bridge, reached via its own Cloudflare Tunnel hostname (see
# led-controller/README.md). KEY is a shared secret matching the Pi's
# /etc/led-controller/env.
LED_CONTROLLER_URL=
LED_CONTROLLER_KEY=

# Label printer, connected via USB to a Pi running the bridge in
# label-printer/. Same pattern as LED_CONTROLLER_* above -- see
# label-printer/README.md. DRIVER is which printer language the app should
# produce: zpl (default, and the only one tested against real hardware),
# brother_ql, dymo, or cups. DPI overrides the resolution that goes with that
# driver; leave it blank unless your printer is the other resolution.
LABEL_PRINTER_URL=
LABEL_PRINTER_KEY=
LABEL_PRINTER_DRIVER=
LABEL_PRINTER_DPI=

# Print bridge (runs on the Pi, not the app -- set these in the Pi's own
# environment, see label-printer/README.md). PRINTER_DEVICE is the raw USB
# device node; PRINTER_CUPS_QUEUE names a CUPS queue for the "cups" driver,
# where the bridge spools the image with `lp` instead of writing bytes.
PRINTER_DEVICE=
PRINTER_CUPS_QUEUE=

# Kiosk auto-login (pi-kiosk/) -- lets a Pi touchscreen kiosk establish a
# real Django session on every boot without ever storing/typing the real
# account password. TOKEN is a long random shared secret (same idea as
# generating DJANGO_SECRET_KEY above); USERNAME is which account it logs in
# as (must already exist, e.g. created via `manage.py createsuperuser`).
KIOSK_AUTOLOGIN_TOKEN=
KIOSK_AUTOLOGIN_USERNAME=seth

# AI enrichment (both optional -- and both can instead be pasted in-app under
# Settings -> "Research & AI", which is the friendlier path for a non-technical
# owner; these env vars are the Docker fallback for people who prefer secrets
# in .env). DeepSeek powers the descriptive suggestions; Tavily does the web
# search for product pages/datasheets/pricing.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=

# In-app feedback relay (optional). FEEDBACK_URL is where the feedback form POSTs — a
# maintainer points this at their own server's /api/feedback/ endpoint so users can send
# bug reports with no email config. FEEDBACK_KEY is the shared secret that endpoint
# checks. Leave both blank and the form falls back to a local email or copy-to-clipboard.
FEEDBACK_URL=
FEEDBACK_KEY=
